<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="HyperValueRow">
        <!-- Persistent label on the left of the row. -->
        <attr name="rowTitle" format="string" />
        <!-- Value shown on the right before a selection is bound. -->
        <attr name="rowValue" format="string" />
    </declare-styleable>
    <declare-styleable name="HyperSlider">
        <attr name="hyperValueFrom" format="float" />
        <attr name="hyperValueTo" format="float" />
        <attr name="hyperStepSize" format="float" />
    </declare-styleable>
    <!-- The accent family; the Monet overlay swaps these for the wallpaper colours. -->
    <attr name="hyperAccent" format="color" />
    <attr name="hyperAccentPressed" format="color" />
    <attr name="hyperAccentDisabled" format="color" />
    <attr name="hyperOnAccent" format="color" />
    <attr name="hyperAccentContainer" format="color" />
    <attr name="hyperOnAccentContainer" format="color" />
    <attr name="hyperSelection" format="color" />
</resources>
