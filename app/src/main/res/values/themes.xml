<?xml version="1.0" encoding="utf-8"?>
<!--
    Mirror2RearUltra theme - HyperOS 4 direction.

    Strategy: token adaptation over Material 3 (see the app's design notes).
    Material components keep their behaviour, semantics and accessibility;
    only their palette, geometry, typography and feedback are restyled. No new
    UI dependency is introduced and no view is converted to Compose.

    Typography note: MiSans is not bundled with this app, so hierarchy is
    carried by size, weight and spacing on the platform sans-serif instead.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Mirror2RearUltra" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Accent: the product's own blue, not Xiaomi brand orange. -->
        <item name="colorPrimary">@color/hyper_accent</item>
        <item name="colorOnPrimary">@color/hyper_on_accent</item>
        <item name="colorPrimaryContainer">@color/hyper_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/hyper_on_accent_container</item>
        <item name="colorSecondary">@color/hyper_accent</item>
        <item name="colorOnSecondary">@color/hyper_on_accent</item>
        <item name="colorSecondaryContainer">@color/hyper_field</item>
        <item name="colorOnSecondaryContainer">@color/hyper_text_primary</item>
        <item name="colorTertiary">@color/hyper_accent</item>
        <item name="colorOnTertiary">@color/hyper_on_accent</item>

        <!-- Surface ladder: page ground sits below grouped content. -->
        <item name="android:colorBackground">@color/hyper_background</item>
        <item name="colorSurface">@color/hyper_surface</item>
        <item name="colorOnSurface">@color/hyper_text_primary</item>
        <item name="colorSurfaceVariant">@color/hyper_field</item>
        <item name="colorOnSurfaceVariant">@color/hyper_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/hyper_background</item>
        <item name="colorSurfaceContainerLow">@color/hyper_background</item>
        <item name="colorSurfaceContainer">@color/hyper_surface_grouped</item>
        <item name="colorSurfaceContainerHigh">@color/hyper_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/hyper_surface_elevated</item>
        <item name="colorSurfaceInverse">@color/hyper_text_primary</item>
        <item name="colorOnSurfaceInverse">@color/hyper_surface</item>

        <item name="colorOutline">@color/hyper_outline_subtle</item>
        <item name="colorOutlineVariant">@color/hyper_divider</item>
        <item name="colorError">@color/hyper_error</item>
        <item name="colorOnError">@color/hyper_on_accent</item>

        <!-- Elevation is expressed by tone, not by shadow stacks. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Component defaults -->
        <item name="materialSwitchStyle">@style/HyperOS.Switch</item>
        <item name="sliderStyle">@style/HyperOS.Slider</item>
        <item name="materialButtonStyle">@style/HyperOS.Button.Primary</item>
        <item name="checkboxStyle">@style/HyperOS.CheckBox</item>
        <item name="textInputStyle">@style/HyperOS.Field</item>
        <item name="toolbarStyle">@style/HyperOS.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/HyperOS.AlertDialog</item>
        <item name="alertDialogTheme">@style/HyperOS.AlertDialog</item>
        <item name="snackbarStyle">@style/HyperOS.Snackbar</item>
        <item name="materialCardViewStyle">@style/HyperOS.Card</item>
        <item name="popupMenuStyle">@style/HyperOS.PopupMenu</item>

        <!-- Type ramp: keeps ?attr/textAppearance* lookups inside our scale. -->
        <item name="textAppearanceHeadlineSmall">@style/HyperOS.Text.PageTitle</item>
        <item name="textAppearanceTitleLarge">@style/HyperOS.Text.Title</item>
        <item name="textAppearanceTitleMedium">@style/HyperOS.Text.RowTitle</item>
        <item name="textAppearanceBodyLarge">@style/HyperOS.Text.Body</item>
        <item name="textAppearanceBodyMedium">@style/HyperOS.Text.Summary</item>
        <item name="textAppearanceBodySmall">@style/HyperOS.Text.Caption</item>
        <item name="textAppearanceLabelLarge">@style/HyperOS.Text.Button</item>

        <!-- System bars follow the page ground. On API 35+ these are ignored
             because edge-to-edge is enforced; the layouts apply real insets. -->
        <item name="android:statusBarColor">@color/hyper_background</item>
        <item name="android:navigationBarColor">@color/hyper_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/hyper_background</item>

        <item name="android:windowAnimationStyle">@style/HyperOS.WindowAnimation</item>
    </style>

    <!--
        Rear-panel output window. Intentionally untouched by the redesign:
        this surface is the mirrored image itself, and any tint or chrome here
        would show up on the physical rear display.
    -->
    <style name="Theme.Mirror2RearUltra.Mirror" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/black</item>
    </style>
</resources>
