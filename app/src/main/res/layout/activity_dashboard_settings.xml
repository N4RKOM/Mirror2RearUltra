<?xml version="1.0" encoding="utf-8"?>
<!--
    Rear panel settings - one screen, five pages.

    The widgets tab used to open this as a single long scroll: what the panel
    shows, its looks, when it dims, what touch does. It now lists those as rows
    with a summary of their value, and each row opens this activity on just
    its own page (EXTRA_SECTION). The sections below are the pages; the
    activity hides all but the one asked for and titles the screen after it.

    Choosing and arranging widgets is not here: the widgets tab does the
    first, DashboardBuilderActivity the second.

    dashboard_settings_content stays a direct child of the NestedScrollView:
    DashboardSettingsActivity.constrainContentOnWideScreens casts its layout
    params to FrameLayout.LayoutParams.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/dashboard_settings_toolbar"
        style="@style/HyperOS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="@drawable/ic_hyper_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboard_settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dashboard_settings_content"
            style="@style/HyperOS.Page">

            <TextView
                android:id="@+id/dashboard_settings_page_title"
                style="@style/HyperOS.PageTitle"
                android:text="@string/dashboard_settings_heading" />

            <!-- ===================== What the panel shows ===================== -->

            <LinearLayout
                android:id="@+id/dashboard_section_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/HyperOS.Group">

                    <com.tpkarras.mirror2rearultra.HyperValueRow
                        android:id="@+id/dashboard_mode_input"
                        style="@style/HyperOS.ValueRow.Single"
                        app:rowTitle="@string/dashboard_mode_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_restart_notice"
                    style="@style/HyperOS.GroupFootnote"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/dashboard_restart_notice"
                    android:textColor="?attr/hyperAccent"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===================== Appearance =====================
                 How everything on the panel looks. How each widget looks, and
                 how a page is laid out, belong to the builder. -->

            <include layout="@layout/panel_section_appearance" />

            <!-- ===================== Panel screen =====================
                 When the panel dims and goes out, and how it keeps from
                 burning in while it stays on. -->

            <include layout="@layout/panel_section_screen" />

            <!-- ===================== Touch and sensors =====================
                 What a finger on the panel, a pocket and a table do to it. -->

            <include layout="@layout/panel_section_touch" />

            <!-- ===================== Shutter, grid and level =====================
                 Camera helpers for the mirror. They are read by the mirror, so
                 the Mirror tab opens this page; the widgets tab does not list
                 them. -->

            <LinearLayout
                android:id="@+id/dashboard_section_mirror_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/HyperOS.Group">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_shutter_switch"
                        style="@style/HyperOS.Switch.Top"
                        android:text="@string/panel_shutter_on_tap" />

                    <TextView
                        android:id="@+id/dashboard_shutter_access_status"
                        style="@style/HyperOS.RowSummary"
                        android:text="@string/shutter_service_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_shutter_access_button"
                        style="@style/HyperOS.ActionRow"
                        android:text="@string/shutter_service_open" />

                    <!-- After the service's status, which sat under it and read
                         as though the countdown were what was switched off. -->
                    <com.tpkarras.mirror2rearultra.HyperValueRow
                        android:id="@+id/dashboard_shutter_delay_input"
                        style="@style/HyperOS.ValueRow"
                        app:rowTitle="@string/shutter_countdown_title" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_mirror_grid_switch"
                        style="@style/HyperOS.Switch"
                        android:text="@string/mirror_grid" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_mirror_level_switch"
                        style="@style/HyperOS.Switch.Bottom"
                        android:text="@string/mirror_level" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
