<?xml version="1.0" encoding="utf-8"?>
<!--
    Device protection.

    Live battery and temperature reading first, then the two limits that act on
    it. Each threshold slider sits directly under the switch that arms it, so a
    disabled limit and its value never read as two unrelated controls.

    device_protection_content stays a direct child of the NestedScrollView -
    SettingsLayout.constrainContentOnWideScreens needs FrameLayout.LayoutParams.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/device_protection_toolbar"
        style="@style/HyperOS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="@drawable/ic_hyper_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/device_protection_content"
            style="@style/HyperOS.Page">

            <TextView
                style="@style/HyperOS.PageTitle"
                android:text="@string/device_protection_title" />

            <!-- Live reading. A surface of its own, like the status card on
                 the hub: it reports, it does not set. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hyper_surface_background"
                android:orientation="vertical"
                android:paddingStart="@dimen/row_padding_horizontal"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/row_padding_horizontal"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    android:id="@+id/device_health_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/device_health_unknown"
                    android:textAppearance="@style/HyperOS.Text.Body" />
            </LinearLayout>

            <LinearLayout
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/section_spacing">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/temperature_protection_switch"
                    style="@style/HyperOS.Switch.Top"
                    android:text="@string/temperature_protection_switch" />

                <TextView
                    android:id="@+id/temperature_threshold_value"
                    style="@style/HyperOS.SliderLabel"
                    android:labelFor="@id/temperature_threshold_slider"
                    android:text="@string/temperature_threshold_default" />

                <com.tpkarras.mirror2rearultra.HyperSlider
                    android:id="@+id/temperature_threshold_slider"
                    style="@style/HyperOS.Slider.Row"
                    android:contentDescription="@string/temperature_threshold_default"
                    app:hyperStepSize="1"
                    app:hyperValueFrom="40"
                    app:hyperValueTo="55" />


                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/battery_protection_switch"
                    style="@style/HyperOS.Switch"
                    android:text="@string/battery_protection_switch" />

                <TextView
                    android:id="@+id/battery_threshold_value"
                    style="@style/HyperOS.SliderLabel"
                    android:labelFor="@id/battery_threshold_slider"
                    android:text="@string/battery_threshold_default" />

                <com.tpkarras.mirror2rearultra.HyperSlider
                    android:id="@+id/battery_threshold_slider"
                    style="@style/HyperOS.Slider.Row"
                    android:contentDescription="@string/battery_threshold_default"
                    app:hyperStepSize="5"
                    app:hyperValueFrom="5"
                    app:hyperValueTo="30" />
            </LinearLayout>

            <TextView
                style="@style/HyperOS.GroupFootnote"
                android:text="@string/device_protection_help" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
