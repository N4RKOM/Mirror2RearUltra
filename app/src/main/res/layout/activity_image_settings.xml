<?xml version="1.0" encoding="utf-8"?>
<!--
    Image and calibration.

    Profiles are chips at the top, with a live miniature of the rear panel
    under them, so what the profile picker scopes is visible while you change
    it. Switching profile re-binds the rows in place.

    Two tabs under the preview, so the sliders on the Calibration tab sit
    beside the miniature they move. Image and Fine tuning belong to the
    selected profile; "All profiles" (projection quality and the calibration
    grid) does not, and shares the Calibration tab because the grid is used
    while lining the panel up. Each header has a "?" that shows the group's
    explanation, which stays out of the way until asked for.

    image_settings_content stays a direct child of the NestedScrollView -
    SettingsLayout.constrainContentOnWideScreens needs FrameLayout.LayoutParams.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/image_settings_toolbar"
        style="@style/HyperOS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="@drawable/ic_hyper_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/image_settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/image_settings_content"
            style="@style/HyperOS.Page">

            <TextView
                android:id="@+id/image_settings_page_title"
                style="@style/HyperOS.PageTitle"
                android:text="@string/profile_image_title" />

            <!-- ===================== Which profile ===================== -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profile_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ===================== Live preview ===================== -->

            <LinearLayout
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <com.tpkarras.mirror2rearultra.PanelPreviewView
                    android:id="@+id/panel_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="76dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/panel_preview_title"
                        android:textAppearance="@style/HyperOS.Text.RowTitle" />

                    <TextView
                        android:id="@+id/panel_preview_zoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/HyperOS.Text.RowSummary" />

                    <TextView
                        android:id="@+id/panel_preview_offset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:textAppearance="@style/HyperOS.Text.RowSummary" />
                </LinearLayout>
            </LinearLayout>


            <!-- ===================== Which tab ===================== -->

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/image_settings_tabs"
                style="@style/HyperOS.SegmentGroup"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/image_settings_tab_image"
                    style="@style/HyperOS.Segment"
                    android:layout_weight="1"
                    android:text="@string/image_settings_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/image_settings_tab_calibration"
                    style="@style/HyperOS.Segment"
                    android:layout_weight="1"
                    android:text="@string/calibration_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/image_settings_tab_capture"
                    style="@style/HyperOS.Segment"
                    android:layout_weight="1"
                    android:text="@string/capture_tab_title" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/image_settings_page_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- ===================== Image ===================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HyperOS.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/image_settings_title" />

                <ImageButton
                    android:id="@+id/help_image_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/help_toggle"
                    android:src="@drawable/ic_help"
                    app:tint="@color/hyper_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/help_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/profile_help" />
                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/brightness_mode_help" />
            </LinearLayout>

            <LinearLayout style="@style/HyperOS.Group">

                <com.tpkarras.mirror2rearultra.HyperValueRow
                    android:id="@+id/scale_mode_input"
                    style="@style/HyperOS.ValueRow.Top"
                    app:rowTitle="@string/scale_mode_title" />


                <com.tpkarras.mirror2rearultra.HyperValueRow
                    android:id="@+id/rotation_input"
                    style="@style/HyperOS.ValueRow"
                    app:rowTitle="@string/rotation_title" />


                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/mirror_switch"
                    style="@style/HyperOS.Switch"
                    android:text="@string/mirror_horizontally" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_horizontal"
                    android:paddingTop="@dimen/row_padding_vertical"
                android:paddingBottom="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_brightness" />

                    <TextView
                        android:id="@+id/brightness_value"
                        style="@style/HyperOS.SliderLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                        android:paddingStart="@dimen/spacing_md"
                        android:labelFor="@id/brightness_slider"
                        android:text="@string/brightness_accessibility" />
                </LinearLayout>

                <com.tpkarras.mirror2rearultra.HyperSlider
                    android:id="@+id/brightness_slider"
                    style="@style/HyperOS.Slider.Row"
                    android:contentDescription="@string/brightness_accessibility"
                    app:hyperStepSize="1"
                    app:hyperValueFrom="10"
                    app:hyperValueTo="100" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/auto_brightness_switch"
                    style="@style/HyperOS.Switch.Bottom"
                    android:text="@string/auto_brightness_title" />
            </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/image_settings_page_calibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- ===================== Calibration ===================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HyperOS.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/fine_tuning_title" />

                <ImageButton
                    android:id="@+id/help_fine_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/help_toggle"
                    android:src="@drawable/ic_help"
                    app:tint="@color/hyper_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/help_fine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/calibration_help" />
                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/overlay_frame_help" />
            </LinearLayout>

            <LinearLayout style="@style/HyperOS.Group">

                <TextView
                    android:id="@+id/calibration_framed_notice"
                    style="@style/HyperOS.RowSummary"
                    android:text="@string/calibration_framed_notice"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_horizontal"
                    android:paddingTop="@dimen/row_padding_vertical"
                android:paddingBottom="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_zoom" />

                    <TextView
                        android:id="@+id/zoom_value"
                        style="@style/HyperOS.SliderLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                        android:paddingStart="@dimen/spacing_md"
                        android:labelFor="@id/zoom_slider"
                        android:text="@string/zoom_default" />
                </LinearLayout>

                <com.tpkarras.mirror2rearultra.HyperSlider
                    android:id="@+id/zoom_slider"
                    style="@style/HyperOS.Slider.Row"
                    android:contentDescription="@string/zoom_accessibility"
                    app:hyperStepSize="5"
                    app:hyperValueFrom="100"
                    app:hyperValueTo="200" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_horizontal"
                    android:paddingTop="@dimen/row_padding_vertical"
                android:paddingBottom="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_offset_h" />

                    <TextView
                        android:id="@+id/horizontal_offset_value"
                        style="@style/HyperOS.SliderLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                        android:paddingStart="@dimen/spacing_md"
                        android:labelFor="@id/horizontal_offset_slider"
                        android:text="@string/horizontal_offset_default" />
                </LinearLayout>

                <com.tpkarras.mirror2rearultra.HyperSlider
                    android:id="@+id/horizontal_offset_slider"
                    style="@style/HyperOS.Slider.Row"
                    android:contentDescription="@string/horizontal_offset_accessibility"
                    app:hyperStepSize="5"
                    app:hyperValueFrom="-50"
                    app:hyperValueTo="50" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_horizontal"
                    android:paddingTop="@dimen/row_padding_vertical"
                android:paddingBottom="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_offset_v" />

                    <TextView
                        android:id="@+id/vertical_offset_value"
                        style="@style/HyperOS.SliderLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                        android:paddingStart="@dimen/spacing_md"
                        android:labelFor="@id/vertical_offset_slider"
                        android:text="@string/vertical_offset_default" />
                </LinearLayout>

                <com.tpkarras.mirror2rearultra.HyperSlider
                    android:id="@+id/vertical_offset_slider"
                    style="@style/HyperOS.Slider.Row"
                    android:contentDescription="@string/vertical_offset_accessibility"
                    app:hyperStepSize="5"
                    app:hyperValueFrom="-50"
                    app:hyperValueTo="50" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_calibration_button"
                    style="@style/HyperOS.ActionRow.Bottom"
                    android:text="@string/reset_calibration" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HyperOS.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/all_profiles_title" />

                <ImageButton
                    android:id="@+id/help_all_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/help_toggle"
                    android:src="@drawable/ic_help"
                    app:tint="@color/hyper_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/help_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/quality_mode_help" />
            </LinearLayout>

            <LinearLayout style="@style/HyperOS.Group">

                <com.tpkarras.mirror2rearultra.HyperValueRow
                    android:id="@+id/quality_mode_input"
                    style="@style/HyperOS.ValueRow.Top"
                    app:rowTitle="@string/quality_mode_title" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/calibration_grid_switch"
                    style="@style/HyperOS.Switch"
                    android:text="@string/calibration_grid_switch" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calibration_preview_button"
                    style="@style/HyperOS.ActionRow.Bottom"
                    android:text="@string/calibration_preview" />

            </LinearLayout>



            </LinearLayout>

            <LinearLayout
                android:id="@+id/image_settings_page_capture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/HyperOS.SectionHeader"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/panel_mirror_tools_title" />

            <LinearLayout
                android:id="@+id/dashboard_section_mirror_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/HyperOS.Group">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_shutter_switch"
                        style="@style/HyperOS.Switch.Top"
                        android:text="@string/panel_shutter_on_tap" />

                    <TextView
                        android:id="@+id/dashboard_shutter_access_status"
                        style="@style/HyperOS.RowSummary"
                        android:text="@string/shutter_service_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_shutter_access_button"
                        style="@style/HyperOS.ActionRow"
                        android:text="@string/shutter_service_open" />

                    <!-- After the service's status, which sat under it and read
                         as though the countdown were what was switched off. -->
                    <com.tpkarras.mirror2rearultra.HyperValueRow
                        android:id="@+id/dashboard_shutter_delay_input"
                        style="@style/HyperOS.ValueRow"
                        app:rowTitle="@string/shutter_countdown_title" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_mirror_grid_switch"
                        style="@style/HyperOS.Switch"
                        android:text="@string/mirror_grid" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_mirror_level_switch"
                        style="@style/HyperOS.Switch.Bottom"
                        android:text="@string/mirror_level" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
