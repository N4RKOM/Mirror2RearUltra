<?xml version="1.0" encoding="utf-8"?>
<!--
    Framing what the panel shows, laid over the app being mirrored.

    The frame covers the whole screen, because the whole screen is what gets
    mirrored. The card floats at the bottom - or at the top when the frame
    needs the bottom - and never sits inside the frame, so the panel never
    shows it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/crop_frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.tpkarras.mirror2rearultra.CropFrameView
        android:id="@+id/crop_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/crop_frame_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/hyper_popup_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/row_padding_horizontal"
        android:paddingTop="@dimen/row_padding_vertical"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_xs">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:accessibilityHeading="true"
            android:text="@string/crop_frame_title"
            android:textAppearance="@style/HyperOS.Text.RowTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/crop_frame_hint"
            android:textAppearance="@style/HyperOS.Text.RowSummary" />

        <TextView
            android:id="@+id/crop_frame_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/HyperOS.Text.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_frame_whole"
                style="@style/HyperOS.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crop_frame_whole" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_frame_fill"
                style="@style/HyperOS.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/crop_frame_fill" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_frame_cancel"
                style="@style/HyperOS.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crop_frame_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_frame_done"
                style="@style/HyperOS.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:minHeight="@dimen/button_height_compact"
                android:text="@string/crop_frame_done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
