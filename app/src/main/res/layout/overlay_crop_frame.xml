<?xml version="1.0" encoding="utf-8"?>
<!--
    Framing what the panel shows, laid over the app being mirrored.

    The frame covers the whole screen, because the whole screen is what gets
    mirrored. The card that goes with it is added at runtime - upright a band
    across the bottom, sideways a column down the right edge where a camera
    keeps its own buttons - and steps aside while the frame is being dragged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/crop_frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.tpkarras.mirror2rearultra.CropFrameView
        android:id="@+id/crop_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
