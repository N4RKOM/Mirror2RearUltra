<?xml version="1.0" encoding="utf-8"?>
<!--
    Profiles and apps, with automation.

    One page for everything about which profile is in use: the profile itself
    (choose, add, rename, delete) and the apps that switch to it, together with
    the automatic switching and the floating control those apps rely on. The
    profile comes first, the apps and their automation follow below it.

    The toolbar keeps the up affordance but drops its title, because the page
    title below states the same thing at full size. The destructive action sits
    apart from the other two and carries the error colour, never the accent.

    profile_manager_content stays a direct child of the NestedScrollView:
    ProfileManagerActivity.constrainContentOnWideScreens casts its layout
    params to FrameLayout.LayoutParams.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/profile_manager_toolbar"
        style="@style/HyperOS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="@drawable/ic_hyper_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_manager_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profile_manager_content"
            style="@style/HyperOS.Page">

            <TextView
                android:id="@+id/profile_manager_page_title"
                style="@style/HyperOS.PageTitle"
                android:text="@string/manage_profiles_and_apps" />

            <!-- ===================== Which profile ===================== -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profile_manager_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/profile_manager_tabs"
                style="@style/HyperOS.SegmentGroup"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_manager_tab_profiles"
                    style="@style/HyperOS.Segment"
                    android:layout_weight="1"
                    android:text="@string/profiles_manager_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_manager_tab_apps"
                    style="@style/HyperOS.Segment"
                    android:layout_weight="1"
                    android:text="@string/profile_apps_title" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ===================== Profiles page ===================== -->

            <LinearLayout
                android:id="@+id/profile_manager_page_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/HyperOS.Group"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <com.tpkarras.mirror2rearultra.PanelPreviewView
                        android:id="@+id/profile_manager_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="96dp" />

                    <TextView
                        android:id="@+id/profile_manager_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textAppearance="@style/HyperOS.Text.RowTitle" />

                    <TextView
                        android:id="@+id/profile_manager_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/HyperOS.Text.RowSummary" />

                    <TextView
                        android:id="@+id/profile_manager_extra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/HyperOS.Text.RowSummary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/rename_profile_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/hyper_surface_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_action_edit"
                            app:tint="@color/hyper_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/profile_action_rename"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/add_profile_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/hyper_surface_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_action_copy"
                            app:tint="@color/hyper_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/profile_action_copy"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/delete_profile_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="0dp"
                        android:background="@drawable/hyper_surface_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_action_delete"
                            app:tint="@color/hyper_error" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/delete_profile"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/profiles_manager_help" />
            </LinearLayout>

            <!-- ===================== Apps page ===================== -->

            <LinearLayout
                android:id="@+id/profile_manager_page_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HyperOS.SectionHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/auto_profile_title" />

                    <ImageButton
                        android:id="@+id/auto_help_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/help_toggle"
                        android:src="@drawable/ic_help"
                        app:tint="@color/hyper_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/auto_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/HyperOS.GroupFootnote"
                        android:text="@string/auto_visibility_help" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HyperOS.Group"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/auto_profile_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/hyper_pill_background"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="@string/auto_state_off"
                        android:textAppearance="@style/HyperOS.Text.RowSummary" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HyperOS.Group"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/auto_profile_switch"
                        style="@style/HyperOS.Switch.Top" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/auto_visibility_switch"
                        style="@style/HyperOS.Switch.Bottom" />
                </LinearLayout>

                <!-- Shown only when automation is on and the permission is
                     missing, so a granted permission removes the row rather
                     than leaving a dead control behind. -->
                <LinearLayout
                    android:id="@+id/usage_access_group"
                    style="@style/HyperOS.Group"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/usage_access_button"
                        style="@style/HyperOS.ActionRow.Single"
                        android:text="@string/grant_usage_access" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HyperOS.SectionHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/overlay_control_title" />

                    <ImageButton
                        android:id="@+id/overlay_help_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/help_toggle"
                        android:src="@drawable/ic_help"
                        app:tint="@color/hyper_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/overlay_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/HyperOS.GroupFootnote"
                        android:text="@string/overlay_control_help" />

                    <TextView
                        style="@style/HyperOS.GroupFootnote"
                        android:text="@string/overlay_frame_help" />
                </LinearLayout>

                <LinearLayout style="@style/HyperOS.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/row_min_height"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/row_padding_horizontal"
                        android:paddingVertical="@dimen/spacing_sm">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/overlay_row_title"
                                android:textAppearance="@style/HyperOS.Text.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/overlay_row_hint"
                                android:textAppearance="@style/HyperOS.Text.RowSummary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/overlay_access_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:background="@drawable/hyper_pill_background"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:textAppearance="@style/HyperOS.Text.RowSummary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/overlay_access_button"
                        style="@style/HyperOS.ActionRow.Bottom"
                        android:text="@string/grant_overlay_access" />
                </LinearLayout>

                <!-- Apps already given to the selected profile, at a glance. -->
                <LinearLayout
                    android:id="@+id/assigned_strip_card"
                    style="@style/HyperOS.Group"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/assigned_strip_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/HyperOS.Text.RowSummary" />

                    <LinearLayout
                        android:id="@+id/assigned_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:orientation="horizontal" />
                </LinearLayout>

            <!-- ===================== App assignment ===================== -->

            <!-- Hidden until the "+" beside the assigned apps is tapped. -->
            <LinearLayout
                android:id="@+id/apps_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Search sits on the page ground, not inside the results group:
                 it filters the group rather than belonging to it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/hyper_search_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/hyper_text_secondary" />

                <EditText
                    android:id="@+id/app_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/HyperOS.Text.RowTitle"
                    android:textColorHint="@color/hyper_text_secondary" />

                <ImageButton
                    android:id="@+id/app_search_clear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_search"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    app:tint="@color/hyper_text_secondary" />
            </LinearLayout>

            <!-- Rows are added by ProfileManagerActivity.renderApps. -->
            <LinearLayout
                android:id="@+id/apps_container"
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_md" />

            <TextView
                android:id="@+id/apps_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center"
                android:paddingBottom="@dimen/spacing_lg"
                android:text="@string/no_apps_found"
                android:textAppearance="@style/HyperOS.Text.Summary"
                android:visibility="gone" />

            <TextView
                style="@style/HyperOS.GroupFootnote"
                android:text="@string/profile_apps_help" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
