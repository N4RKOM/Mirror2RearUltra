<?xml version="1.0" encoding="utf-8"?>
<!--
    Add-widget gallery - the one place a widget is switched on or off.

    Widgets are cards, three to a row, under the group they belong to; a card
    is tapped to put the widget on the page being edited and tapped again to
    take it off. A search field and group chips narrow the list. This replaces
    thirty-six switches in five lists, which said nothing about a widget but
    its name.

    What a widget needs - a city, a text, a code, a permission - is not beside
    its card any more: the blocks under "Widget settings" appear when a widget
    that uses them is on, so they only take room while they matter.

    widget_picker_content stays a direct child of the NestedScrollView:
    SettingsLayout.constrainContentOnWideScreens needs FrameLayout.LayoutParams.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/widget_picker_toolbar"
        style="@style/HyperOS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="@drawable/ic_hyper_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/widget_picker_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/widget_picker_content"
            style="@style/HyperOS.Page">

            <TextView
                android:id="@+id/widget_picker_page_title"
                style="@style/HyperOS.PageTitle"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/widgets_home_add" />

            <TextView
                style="@style/HyperOS.GroupFootnote"
                android:paddingTop="0dp"
                android:text="@string/widget_gallery_help" />

            <LinearLayout
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_md">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/widget_picker_search_container"
                    style="@style/HyperOS.Field.Flat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/widget_gallery_search"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/widget_picker_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textAppearance="@style/HyperOS.Text.RowTitle" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Which page's widgets to show. Only there once there is more
                 than one page; built by WidgetPickerActivity. -->
            <HorizontalScrollView
                android:id="@+id/widget_picker_page_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/widget_picker_page_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/widget_picker_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Built by WidgetPickerActivity: headers and rows of cards. -->
            <LinearLayout
                android:id="@+id/widget_picker_gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/widget_picker_no_results"
                style="@style/HyperOS.GroupFootnote"
                android:paddingTop="@dimen/spacing_md"
                android:text="@string/widget_gallery_no_results"
                android:visibility="gone" />

            <!-- ===================== Widget settings ===================== -->

            <TextView
                android:id="@+id/widget_picker_settings_header"
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/widget_gallery_settings"
                android:visibility="gone" />

            <!-- The city belongs to the weather widget and to the three that
                 read the same forecast. -->
            <LinearLayout
                android:id="@+id/widget_picker_block_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/HyperOS.Group">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dashboard_weather_city_container"
                        style="@style/HyperOS.Field.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/dashboard_weather_city"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dashboard_weather_city_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:maxLength="80"
                            android:maxLines="1"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/dashboard_weather_help" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_picker_block_location"
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dashboard_location_access_status"
                    style="@style/HyperOS.RowSummary"
                    android:accessibilityLiveRegion="polite" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_location_access_button"
                    style="@style/HyperOS.ActionRow.Bottom"
                    android:text="@string/dashboard_grant_location_access"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_picker_block_media"
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dashboard_media_access_status"
                    style="@style/HyperOS.RowSummary"
                    android:accessibilityLiveRegion="polite" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_media_access_button"
                    style="@style/HyperOS.ActionRow"
                    android:text="@string/dashboard_grant_media_access"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dashboard_media_now_playing"
                    style="@style/HyperOS.TextRow"
                    android:accessibilityLiveRegion="polite"
                    android:breakStrategy="simple"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/dashboard_media_nothing_playing"
                    android:textAppearance="@style/HyperOS.Text.RowValue" />

                <!-- Not a setting: a remote for checking that the widget picks
                     the session up. Peer actions, so one weight for all three. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_horizontal"
                    android:paddingEnd="@dimen/row_padding_horizontal"
                    android:paddingBottom="@dimen/row_padding_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_media_previous_button"
                        style="@style/HyperOS.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_media_previous" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_media_play_pause_button"
                        style="@style/HyperOS.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/dashboard_media_play_pause" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_media_next_button"
                        style="@style/HyperOS.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_media_next" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_picker_block_custom_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/HyperOS.Group"
                    android:layout_marginTop="@dimen/spacing_md">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dashboard_custom_text_container"
                        style="@style/HyperOS.Field.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/dashboard_custom_text_hint"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dashboard_custom_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLength="60"
                            android:maxLines="1"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/dashboard_custom_text_help" />
            </LinearLayout>

            <!-- The code's content: a text or link, or a Wi-Fi network to join. -->
            <LinearLayout
                android:id="@+id/widget_picker_block_qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/HyperOS.Group"
                    android:layout_marginTop="@dimen/spacing_md">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dashboard_qr_wifi_switch"
                        style="@style/HyperOS.Switch.Top"
                        android:text="@string/dashboard_qr_wifi" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dashboard_qr_text_container"
                        style="@style/HyperOS.Field.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/dashboard_qr_text_hint"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dashboard_qr_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textUri"
                            android:maxLength="200"
                            android:maxLines="1"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dashboard_qr_ssid_container"
                        style="@style/HyperOS.Field.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/dashboard_qr_ssid_hint"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dashboard_qr_ssid_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="32"
                            android:maxLines="1"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dashboard_qr_password_container"
                        style="@style/HyperOS.Field.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/dashboard_qr_password_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dashboard_qr_password_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLength="63"
                            android:maxLines="1"
                            android:textAppearance="@style/HyperOS.Text.RowTitle" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    style="@style/HyperOS.GroupFootnote"
                    android:text="@string/dashboard_qr_help" />
            </LinearLayout>

            <!-- ===================== Units =====================
                 How the readings are written, so it sits with the widgets
                 rather than with the panel's looks. -->

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_units_title" />

            <LinearLayout style="@style/HyperOS.Group">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dashboard_imperial_units_switch"
                    style="@style/HyperOS.Switch.Single"
                    android:text="@string/dashboard_units_imperial" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
