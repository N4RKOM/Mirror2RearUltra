<?xml version="1.0" encoding="utf-8"?>
<!--
    The framing card for a screen on its side: a column down the right edge,
    where a camera keeps its own buttons.

    A band across the bottom would lie over the viewfinder, which is the one
    thing being framed; beside it there is room that the frame has no use for.
    The words are left to the upright card - a column is no place for a
    paragraph, and the frame is the same frame either way round.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/crop_frame_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/hyper_popup_background"
    android:elevation="8dp"
    android:minWidth="180dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/row_padding_vertical"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/row_padding_vertical">

    <TextView
        android:id="@+id/crop_frame_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/HyperOS.Text.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/crop_frame_whole"
        style="@style/HyperOS.Button.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/crop_frame_whole" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/crop_frame_fill"
        style="@style/HyperOS.Button.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/crop_frame_fill" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/crop_frame_cancel"
        style="@style/HyperOS.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/crop_frame_cancel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/crop_frame_done"
        style="@style/HyperOS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:minHeight="@dimen/button_height_compact"
        android:text="@string/crop_frame_done" />
</LinearLayout>
