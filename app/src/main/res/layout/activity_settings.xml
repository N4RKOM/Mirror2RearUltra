<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hyper_background" android:fitsSystemWindows="true">
    <androidx.core.widget.NestedScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/settings_content" style="@style/HyperOS.Page" android:paddingBottom="112dp">
            <TextView style="@style/HyperOS.PageTitle" android:text="@string/settings_title" android:id="@+id/section_title" />
            <!-- Widgets tab: the rear panel first, then what is on the page, then the
                 settings that reach every page. A page's own tools stay in the builder. -->
            <LinearLayout android:id="@+id/section_widgets" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView android:id="@+id/widgets_home_preview_container" style="@style/HyperOS.Card" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="@dimen/spacing_sm" app:strokeColor="@color/hyper_outline_subtle" app:strokeWidth="1dp">
                    <com.tpkarras.mirror2rearultra.RearDashboardView android:id="@+id/widgets_home_preview_view" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <View android:id="@+id/widgets_home_preview_tap" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="@string/widgets_home_builder" />
                </com.google.android.material.card.MaterialCardView>
                <FrameLayout android:id="@+id/widgets_home_page_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:visibility="gone" />
                <TextView android:id="@+id/widgets_home_widgets_header" style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/widgets_home_widgets_header" />
                <LinearLayout style="@style/HyperOS.Group">
                    <LinearLayout android:id="@+id/widgets_home_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/widgets_home_add_button" style="@style/HyperOS.NavRow.Single" android:text="@string/widgets_home_add" />
                </LinearLayout>
                <TextView android:id="@+id/widgets_home_hint" style="@style/HyperOS.GroupFootnote" android:text="@string/widgets_home_preview_hint" />
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/widgets_home_panel" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.google.android.material.button.MaterialButton android:id="@+id/widgets_home_appearance_button" style="@style/HyperOS.NavRow.Single" android:text="@string/dashboard_appearance_title" />
                    <TextView android:id="@+id/widgets_home_appearance_summary" style="@style/HyperOS.RowSummary" />
                    <include android:id="@+id/widgets_home_appearance_panel" layout="@layout/panel_section_appearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/widgets_home_screen_button" style="@style/HyperOS.NavRow.Single" android:text="@string/panel_screen_title" />
                    <TextView android:id="@+id/widgets_home_screen_summary" style="@style/HyperOS.RowSummary" />
                    <include android:id="@+id/widgets_home_screen_panel" layout="@layout/panel_section_screen" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/widgets_home_touch_button" style="@style/HyperOS.NavRow.Single" android:text="@string/panel_touch_title" />
                    <TextView android:id="@+id/widgets_home_touch_summary" style="@style/HyperOS.RowSummary" />
                    <include android:id="@+id/widgets_home_touch_panel" layout="@layout/panel_section_touch" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/widgets_home_all_pages" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.google.android.material.button.MaterialButton android:id="@+id/widgets_home_builder_button" style="@style/HyperOS.NavRow.Top" android:text="@string/widgets_home_builder" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/widgets_home_templates_button" style="@style/HyperOS.NavRow.Bottom" android:text="@string/dashboard_templates_title" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/section_mirror" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/status_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hyper_surface_background" android:orientation="vertical" android:padding="@dimen/spacing_md">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <com.tpkarras.mirror2rearultra.PanelPreviewView android:id="@+id/hub_panel_preview" android:layout_width="wrap_content" android:layout_height="64dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_md" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/status_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_title" android:textAppearance="@style/HyperOS.Text.SectionHeader" />
                            <TextView android:id="@+id/status_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:accessibilityLiveRegion="polite" android:breakStrategy="simple" android:hyphenationFrequency="none" android:textAppearance="@style/HyperOS.Text.StatusValue" />
                            <TextView android:id="@+id/hub_profile_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:textAppearance="@style/HyperOS.Text.RowSummary" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/hub_toggle_button" style="@style/HyperOS.Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_md" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:clipToPadding="false" android:scrollbars="none">
                    <LinearLayout android:id="@+id/hub_profile_chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout style="@style/HyperOS.Group" android:layout_marginTop="@dimen/spacing_md">
                    <LinearLayout android:id="@+id/image_settings_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingHorizontal="@dimen/spacing_md" android:paddingVertical="@dimen/spacing_sm">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:src="@drawable/ic_row_image" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_md" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_image_title" android:textAppearance="@style/HyperOS.Text.RowTitle" />
                            <TextView android:id="@+id/hub_image_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/HyperOS.Text.RowSummary" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_hyper_chevron" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="@color/hyper_divider" />
                    <LinearLayout android:id="@+id/manage_profiles_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingHorizontal="@dimen/spacing_md" android:paddingVertical="@dimen/spacing_sm">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:src="@drawable/ic_row_profiles" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_md" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/manage_profiles_and_apps" android:textAppearance="@style/HyperOS.Text.RowTitle" />
                            <TextView android:id="@+id/hub_profiles_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/HyperOS.Text.RowSummary" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_hyper_chevron" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/section_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!-- Device status first: what this phone can do decides what the rest does. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hyper_surface_background" android:orientation="vertical" android:padding="@dimen/spacing_md">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capabilities_title" android:textAppearance="@style/HyperOS.Text.SectionHeader" />
                    <TextView android:id="@+id/root_status_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:background="@drawable/hyper_status_chip_background" android:paddingHorizontal="@dimen/spacing_sm" android:paddingVertical="@dimen/spacing_xs" android:text="@string/capability_unknown" android:textAppearance="@style/HyperOS.Text.RowSummary" android:textColor="@color/hyper_on_accent_container" />
                    <TextView android:id="@+id/hardware_brightness_status_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:background="@drawable/hyper_status_chip_background" android:paddingHorizontal="@dimen/spacing_sm" android:paddingVertical="@dimen/spacing_xs" android:text="@string/capability_unknown" android:textAppearance="@style/HyperOS.Text.RowSummary" android:textColor="@color/hyper_on_accent_container" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/capability_refresh_button" style="@style/HyperOS.Button.Compact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/capability_refresh" app:icon="@drawable/ic_row_refresh" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/app_look_title" />
                <LinearLayout style="@style/HyperOS.Group">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/spacing_sm">
                        <TextView android:id="@+id/app_theme_title_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_theme_title" />
                        <FrameLayout android:id="@+id/app_theme_segments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/spacing_md" />
                    </LinearLayout>
                    <com.tpkarras.mirror2rearultra.HyperValueRow android:id="@+id/app_language_input" style="@style/HyperOS.ValueRow" app:rowTitle="@string/app_language_title" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/app_monet_switch" style="@style/HyperOS.Switch" android:text="@string/app_monet_title" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/app_blur_switch" style="@style/HyperOS.Switch.Bottom" android:text="@string/app_blur_title" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/dashboard_settings_title" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.tpkarras.mirror2rearultra.HyperValueRow android:id="@+id/dashboard_mode_input" style="@style/HyperOS.ValueRow" app:rowTitle="@string/dashboard_mode_title" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/stock_center_switch" style="@style/HyperOS.Switch" android:text="@string/stock_center_title" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/device_protection_button" style="@style/HyperOS.NavRow.Single" android:text="@string/device_protection_title" />
                </LinearLayout>
                <TextView android:id="@+id/dashboard_restart_notice" style="@style/HyperOS.GroupFootnote" android:accessibilityLiveRegion="polite" android:text="@string/dashboard_restart_notice" android:textColor="?attr/hyperAccent" android:visibility="gone" />
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/backup_title" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/export_backup_button" style="@style/HyperOS.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/spacing_xs" android:layout_weight="1" android:text="@string/backup_export_short" app:icon="@drawable/ic_row_export" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/import_backup_button" style="@style/HyperOS.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:layout_weight="1" android:text="@string/backup_import_short" app:icon="@drawable/ic_row_import" app:iconGravity="textStart" />
                </LinearLayout>
                <TextView android:id="@+id/backup_status" style="@style/HyperOS.GroupFootnote" android:accessibilityLiveRegion="polite" android:text="@string/backup_status_ready" />
                <TextView style="@style/HyperOS.GroupFootnote" android:text="@string/backup_help" />
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/app_group_title" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.google.android.material.button.MaterialButton android:id="@+id/app_about_button" style="@style/HyperOS.NavRow.Top" android:text="@string/app_about_title" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/app_source_button" style="@style/HyperOS.NavRow.Bottom" android:text="@string/app_source_title" />
                </LinearLayout>
                <TextView style="@style/HyperOS.GroupFootnote" android:paddingTop="@dimen/spacing_lg" android:text="@string/settings_saved_automatically" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- Frosted glass for the bar below; off unless chosen. -->
    <com.tpkarras.mirror2rearultra.FrostedBackdropView android:id="@+id/frosted_backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:importantForAccessibility="no" />
    <androidx.compose.ui.platform.ComposeView android:id="@+id/floating_navigation"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />
</FrameLayout>