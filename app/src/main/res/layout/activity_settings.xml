<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hyper_background" android:fitsSystemWindows="true">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/settings_content" style="@style/HyperOS.Page" android:paddingBottom="112dp">
            <TextView style="@style/HyperOS.PageTitle" android:text="@string/settings_title" android:id="@+id/section_title" />
            <LinearLayout android:id="@+id/section_widgets" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/HyperOS.GroupFootnote" android:paddingTop="@dimen/spacing_sm" android:text="@string/widgets_home_intro" />
                <LinearLayout style="@style/HyperOS.Group" android:layout_marginTop="@dimen/section_spacing">
                    <TextView android:id="@+id/widgets_home_count" style="@style/HyperOS.TextRow" android:accessibilityLiveRegion="polite" android:textAppearance="@style/HyperOS.Text.StatusValue" />
                    <TextView style="@style/HyperOS.GroupFootnote" android:paddingStart="@dimen/row_padding_horizontal" android:paddingEnd="@dimen/row_padding_horizontal" android:text="@string/widgets_home_count_help" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/widget_picker_button" style="@style/HyperOS.NavRow.Bottom" android:text="@string/widgets_home_choose" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/widgets_home_arrangement" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.google.android.material.button.MaterialButton android:id="@+id/widget_builder_button" style="@style/HyperOS.NavRow.Top" android:text="@string/dashboard_builder_title" />
                    <TextView style="@style/HyperOS.GroupFootnote" android:paddingStart="@dimen/row_padding_horizontal" android:paddingEnd="@dimen/row_padding_horizontal" android:text="@string/widgets_home_arrangement_help" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/widgets_home_display" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_settings_button" style="@style/HyperOS.NavRow.Top" android:text="@string/dashboard_settings_title" />
                    <TextView style="@style/HyperOS.GroupFootnote" android:paddingStart="@dimen/row_padding_horizontal" android:paddingEnd="@dimen/row_padding_horizontal" android:text="@string/widgets_home_display_help" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/section_mirror" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hyper_surface_background" android:orientation="vertical" android:paddingStart="@dimen/row_padding_horizontal" android:paddingTop="@dimen/spacing_md" android:paddingEnd="@dimen/row_padding_horizontal" android:paddingBottom="@dimen/spacing_md">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_title" android:textAppearance="@style/HyperOS.Text.SectionHeader" />
                    <TextView android:id="@+id/status_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:accessibilityLiveRegion="polite" android:breakStrategy="simple" android:hyphenationFrequency="none" android:textAppearance="@style/HyperOS.Text.StatusValue" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/profile_title" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.tpkarras.mirror2rearultra.HyperValueRow android:id="@+id/profile_input" style="@style/HyperOS.ValueRow.Top" app:rowTitle="@string/profile_selected_title" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/image_settings_button" style="@style/HyperOS.NavRow" android:text="@string/profile_image_title" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/manage_profiles_button" style="@style/HyperOS.NavRow.Bottom" android:text="@string/manage_profiles_and_apps" />
                </LinearLayout>
                <TextView android:id="@+id/profile_summary" style="@style/HyperOS.GroupFootnote" />
                <LinearLayout style="@style/HyperOS.Group" android:layout_marginTop="@dimen/section_spacing">
                    <com.google.android.material.button.MaterialButton android:id="@+id/automation_button" style="@style/HyperOS.NavRow" android:text="@string/auto_profile_title" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/section_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout style="@style/HyperOS.Group" android:layout_marginTop="@dimen/section_spacing">
                    <com.google.android.material.button.MaterialButton android:id="@+id/device_protection_button" style="@style/HyperOS.NavRow.Bottom" android:text="@string/device_protection_title" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/capabilities_title" />
                <LinearLayout style="@style/HyperOS.Group">
                    <TextView android:id="@+id/root_status_value" style="@style/HyperOS.TextRow" android:text="@string/capability_unknown" />
                    <TextView android:id="@+id/hardware_brightness_status_value" style="@style/HyperOS.TextRow" android:text="@string/capability_unknown" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/capability_refresh_button" style="@style/HyperOS.ActionRow.Bottom" android:text="@string/capability_refresh" />
                </LinearLayout>
                <TextView style="@style/HyperOS.SectionHeader" android:layout_marginTop="@dimen/section_spacing" android:text="@string/backup_title" />
                <LinearLayout style="@style/HyperOS.Group">
                    <com.google.android.material.button.MaterialButton android:id="@+id/export_backup_button" style="@style/HyperOS.ActionRow.Top" android:text="@string/backup_export" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/import_backup_button" style="@style/HyperOS.ActionRow" android:text="@string/backup_import" />
                    <TextView android:id="@+id/backup_status" style="@style/HyperOS.TextRow" android:accessibilityLiveRegion="polite" android:text="@string/backup_status_ready" android:textAppearance="@style/HyperOS.Text.RowValue" />
                </LinearLayout>
                <TextView style="@style/HyperOS.GroupFootnote" android:text="@string/backup_help" />
                <TextView style="@style/HyperOS.GroupFootnote" android:paddingTop="@dimen/spacing_lg" android:text="@string/settings_saved_automatically" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.compose.ui.platform.ComposeView android:id="@+id/floating_navigation"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />
</FrameLayout>