<?xml version="1.0" encoding="utf-8"?>
<!--
    One widget in the builder's list: grip, the widget's icon, its name with a
    line of what it is set to, and a chevron for its settings. The group
    shape behind it is set by the activity from the row's place in the list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hyper_row_bg_middle"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/row_padding_horizontal">

    <ImageView
        android:id="@+id/builder_item_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_drag_handle" />

    <ImageView
        android:id="@+id/builder_item_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/builder_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/HyperOS.Text.RowTitle" />

        <TextView
            android:id="@+id/builder_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/HyperOS.Text.RowSummary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/builder_item_chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_hyper_expand" />
</LinearLayout>
