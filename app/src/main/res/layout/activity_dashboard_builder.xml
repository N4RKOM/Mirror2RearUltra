<?xml version="1.0" encoding="utf-8"?>
<!--
    Dashboard builder.

    Unlike the settings pages this screen is a workspace, so it keeps a live
    preview near the top and the editable widget list below it. The preview is
    a genuine object rather than a settings row, so it stays a card.

    Widget rows are built by DashboardBuilderActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/dashboard_builder_toolbar"
        style="@style/HyperOS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="@drawable/ic_hyper_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboard_builder_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout style="@style/HyperOS.Page">

            <TextView
                style="@style/HyperOS.PageTitle"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/dashboard_builder_title" />

            <TextView
                style="@style/HyperOS.GroupFootnote"
                android:paddingTop="0dp"
                android:text="@string/dashboard_builder_help" />

            <!-- ===================== Preview ===================== -->

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_builder_preview" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_builder_orientation"
                    style="@style/HyperOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_builder_layout"
                    style="@style/HyperOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:maxLines="2" />
            </LinearLayout>

            <TextView
                android:id="@+id/dashboard_builder_preview_page_note"
                style="@style/HyperOS.GroupFootnote"
                android:text="@string/dashboard_builder_preview_page_note"
                android:visibility="gone" />

            <!-- The rear panel is black, so the preview keeps a hairline
                 outline to stay readable against a dark page background. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_builder_preview_container"
                style="@style/HyperOS.Card"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="@dimen/spacing_sm"
                app:strokeColor="@color/hyper_outline_subtle"
                app:strokeWidth="1dp">

                <com.tpkarras.mirror2rearultra.RearDashboardView
                    android:id="@+id/dashboard_builder_preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:id="@+id/dashboard_builder_preview_carousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/dashboard_builder_preview_carousel_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Only the free layout has anywhere to snap to, so the row
                 appears with it. Shown and hidden by the activity. -->
            <LinearLayout
                android:id="@+id/dashboard_builder_snap_group"
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_sm"
                android:visibility="gone">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dashboard_builder_snap_switch"
                    style="@style/HyperOS.Switch.Single"
                    android:text="@string/dashboard_builder_snap" />
            </LinearLayout>

            <TextView
                android:id="@+id/dashboard_builder_overflow"
                style="@style/HyperOS.GroupFootnote"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/hyper_accent"
                android:visibility="gone" />

            <!-- What the preview responds to depends on the layout, so the
                 line is written by DashboardBuilderActivity. -->
            <TextView
                android:id="@+id/dashboard_builder_preview_hint"
                style="@style/HyperOS.GroupFootnote"
                android:accessibilityLiveRegion="polite"
                android:text="@string/dashboard_builder_preview_pick_hint" />

            <!-- The in-app preview can only approximate a 126x294 panel at a
                 different density, so legibility is checked on the panel. -->
            <LinearLayout
                style="@style/HyperOS.Group"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_builder_show_on_panel"
                    style="@style/HyperOS.ActionRow.Single"
                    android:text="@string/dashboard_builder_show_on_panel" />
            </LinearLayout>

            <TextView
                style="@style/HyperOS.GroupFootnote"
                android:text="@string/dashboard_builder_preview_note" />

            <!-- ===================== Presets ===================== -->

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_presets_title" />

            <LinearLayout
                style="@style/HyperOS.Group">

                <com.tpkarras.mirror2rearultra.HyperValueRow
                    android:id="@+id/dashboard_builder_preset"
                    style="@style/HyperOS.ValueRow.Single"
                    app:rowTitle="@string/dashboard_presets_title"
                    app:rowValue="@string/dashboard_builder_choose_value" />
            </LinearLayout>

            <!-- ===================== Saved arrangements =====================
                 Two separate things, so they are two separate groups. The
                 profile template is applied for you when you switch to this
                 profile; named templates are applied by hand and outlive it. -->

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_profile_template_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_custom_template_save"
                    style="@style/HyperOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_custom_template_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_custom_template_apply"
                    style="@style/HyperOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/dashboard_custom_template_apply" />
            </LinearLayout>

            <TextView
                android:id="@+id/dashboard_profile_template_note"
                style="@style/HyperOS.GroupFootnote"
                android:accessibilityLiveRegion="polite"
                android:text="@string/dashboard_profile_template_help" />

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_custom_templates_title" />

            <!-- One row per saved template, built by the activity. -->
            <LinearLayout
                android:id="@+id/dashboard_named_templates"
                style="@style/HyperOS.Group"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashboard_named_template_add"
                style="@style/HyperOS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/dashboard_named_template_add" />

            <TextView
                android:id="@+id/dashboard_named_templates_empty"
                style="@style/HyperOS.GroupFootnote"
                android:text="@string/dashboard_named_templates_help" />

            <!-- ===================== Pages =====================
                 Pages used to exist only as a per-widget number, with nothing
                 saying what a page was or that the panel cycles through them.
                 Setting the count here makes that explicit, and at one page
                 the per-widget control disappears entirely. -->

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_builder_pages" />

            <LinearLayout style="@style/HyperOS.Group">

                <com.tpkarras.mirror2rearultra.HyperValueRow
                    android:id="@+id/dashboard_builder_pages"
                    style="@style/HyperOS.ValueRow.Single"
                    app:rowTitle="@string/dashboard_builder_pages"
                    app:rowValue="@string/dashboard_builder_one_page" />
            </LinearLayout>

            <TextView
                style="@style/HyperOS.GroupFootnote"
                android:text="@string/dashboard_builder_pages_help" />

            <!-- ===================== Widgets ===================== -->

            <TextView
                style="@style/HyperOS.SectionHeader"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/dashboard_builder_widgets_title" />

            <!-- Selection lives in WidgetPickerActivity, so this screen only
                 arranges what is already on and never lists the rest. -->
            <LinearLayout style="@style/HyperOS.Group">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_builder_choose"
                    style="@style/HyperOS.NavRow.Single"
                    android:text="@string/dashboard_builder_choose" />
            </LinearLayout>

            <TextView
                android:id="@+id/dashboard_builder_empty"
                style="@style/HyperOS.GroupFootnote"
                android:paddingTop="@dimen/spacing_md"
                android:text="@string/dashboard_builder_empty"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dashboard_builder_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View style="@style/HyperOS.BottomBarEdge" />

    <!-- Reset is separated from Done by weight, not just position: it discards
         the arrangement, so it never carries the primary accent. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hyper_background"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin_horizontal"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/page_margin_horizontal"
        android:paddingBottom="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_builder_reset"
            style="@style/HyperOS.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dashboard_builder_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_builder_done"
            style="@style/HyperOS.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/done" />
    </LinearLayout>
</LinearLayout>
