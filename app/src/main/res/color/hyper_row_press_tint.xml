<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal press response for rows built on MaterialButton, which manages its
     own background and so cannot take a state-list drawable directly. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/hyper_press_on_surface" />
    <item android:state_focused="true" android:color="@color/hyper_press_on_surface" />
    <item android:color="@android:color/transparent" />
</selector>
