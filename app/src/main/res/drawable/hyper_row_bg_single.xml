<?xml version="1.0" encoding="utf-8"?>
<!--
    Row press feedback for the single row of a group.

    HyperOS answers a touch with a tonal light response rather than a Material
    ripple, so this is a plain state list. Corners match the group so the
    highlight never spills past the container edge.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hyper_press_on_surface" />
            <corners
                android:topLeftRadius="@dimen/group_corner"
                android:topRightRadius="@dimen/group_corner"
                android:bottomLeftRadius="@dimen/group_corner"
                android:bottomRightRadius="@dimen/group_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hyper_press_on_surface" />
            <corners
                android:topLeftRadius="@dimen/group_corner"
                android:topRightRadius="@dimen/group_corner"
                android:bottomLeftRadius="@dimen/group_corner"
                android:bottomRightRadius="@dimen/group_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
