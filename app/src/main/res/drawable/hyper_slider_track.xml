<?xml version="1.0" encoding="utf-8"?>
<!--
    Capsule track for HyperSlider.

    The fill is a clip drawable, so at full value it covers the track exactly.
    The Material slider leaves a corner-radius gap at maximum once the track is
    this thick, which reads as a bar that will not fill.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/hyper_track_off" />
            <corners android:radius="@dimen/slider_corner" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <solid android:color="@color/hyper_accent" />
                <corners android:radius="@dimen/slider_corner" />
            </shape>
        </clip>
    </item>
</layer-list>
